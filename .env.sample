# Runtime env: dev|staging|prod (example: dev)
APP_ENV=dev
# Enable verbose debug output (example: false)
DEBUG_MODE=false
# Include request/response details in logs (example: false)
DETAILED_LOGGING=false

# Mongo connection URI (example: mongodb://localhost:27017)
MONGO_URI=
# Mongo database name (example: cybersentinel)
MONGO_DB=

# JWT signing secret (example: S3cure-Dev-Secret-Use-Env-Only)
JWT_SECRET=
# JWT signing algorithm (example: HS256)
JWT_ALGORITHM=HS256
# JWT expiry in minutes (example: 60)
JWT_EXP_MINUTES=60

# Enable Kafka ingestion (example: false)
KAFKA_ENABLED=false
# Kafka brokers (example: localhost:9092)
KAFKA_BOOTSTRAP_SERVERS=
# Kafka topic name (example: cybersentinel-logs)
KAFKA_TOPIC=
# Kafka consumer group id (example: cybersentinel-backend)
KAFKA_GROUP_ID=

# Model artifact directory (example: app/ml/models)
MODEL_DIR=app/ml/models
# Require model integrity checks (example: true)
MODEL_INTEGRITY_REQUIRED=true
# Score threshold for anomaly alerts (example: 0.65)
ANOMALY_SCORE_THRESHOLD=0.65

# Optional agent service URL (example: http://localhost:9000)
AGENT_SERVICE_URL=
# Agent call timeout in seconds (example: 10)
AGENT_TIMEOUT_SECONDS=10

# CORS origins for the frontend (comma separated)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
