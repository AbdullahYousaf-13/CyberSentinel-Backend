APP_ENV=dev
DEBUG_MODE=true
DETAILED_LOGGING=false

# MongoDB
# Preferred:
MONGO_URI=
# Optional fallback when MONGO_URI is empty:
MONGO_USER=
MONGO_PASSWORD=
MONGO_HOST=
MONGO_DB=cybersentinel

# Auth
CS_API_ACCESS_TOKEN=your_token_here
JWT_SECRET=dev-secret-12345678
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=1440

# ML Model (Cloud-Only)
# Required: backend startup fails if MODEL_API_URL is empty/unreachable.
MODEL_API_URL=http://127.0.0.1:8010
# Timeout for cloud model API requests in seconds (example: 10)
MODEL_API_TIMEOUT_SECONDS=10
MODEL_ADMIN_TOKEN=change-me-model-admin-token
ANOMALY_SCORE_THRESHOLD=0.65
RAW_WAZUH_TRAINING_PATH=C:/Users/anumy/Downloads/cybersentinel_raw_wazuh_logs.json
MIN_SAMPLES_PER_ATTACK_CLASS=50
# Deprecated local-model settings (ignored in cloud-only mode)
# MODEL_DIR=app/ml/models
# MODEL_INTEGRITY_REQUIRED=true
MODEL_DIR=app/ml/models
MODEL_INTEGRITY_REQUIRED=true

# Wazuh raw archive forwarder (POST /api/raw_wazuh_logs, header x-ingestion-key)
WAZUH_INGEST_KEY=
# Ubuntu forwarder runtime vars (set on Wazuh machine shell/service)
# CS_BACKEND_URL=http://<windows-backend-ip>:8000
# WAZUH_ARCHIVES_PATH=/var/ossec/logs/archives/archives.json
# WAZUH_FORWARDER_OFFSET_PATH defaults to ~/.cybersentinel-wazuh-forwarder.offset.json (no root). Optional: /var/lib/... for systemd as root
# WAZUH_FORWARDER_POLL_SEC=4

# Agent
AGENT_SERVICE_URL=
AGENT_TIMEOUT_SECONDS=10

# CORS
CORS_ALLOW_ORIGINS=*

# Frontend
FRONTEND_BASE_URL=http://localhost:3000

# Email (Gmail SMTP example values)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=no-reply@example.com

# Email TTLs
EMAIL_VERIFY_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=15
